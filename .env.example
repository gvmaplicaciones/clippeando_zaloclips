ANTHROPIC_API_KEY=

# Opcionales - por defecto usan rutas relativas a la raiz del proyecto.
# Descomenta y ajusta solo si necesitas rutas distintas (ej. en un VPS).
# PROJECT_ROOT=
# INPUT_DIR=
# TRANSCRIPTS_DIR=
# MOMENTS_DIR=
# METADATA_DIR=
#
# OUTPUT_DIR: donde se guardan los clips finales. Acepta cualquier ruta
# absoluta fuera del repo, por ejemplo una carpeta de Google Drive Desktop
# sincronizada en Windows:
# OUTPUT_DIR=G:\Mi unidad\ZaleteClips
# ANTHROPIC_MODEL=claude-haiku-4-5
# WHISPER_MODEL_SIZE=medium
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto
# WHISPER_LANGUAGE=

# Solo si YouTube pide "Sign in to confirm you're not a bot" al descargar
# (comun en Colab/VPS). Ver README para como exportar cookies.txt.
# YTDLP_COOKIES_FILE=/content/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_PLAYER_CLIENT=web,web_creator,tv
